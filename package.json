{
  "name": "cleverbot",
  "version": "2.0.0",
  "description": "AI chat assistant using the best available free OpenRouter models, proxied through Netlify functions so the API key stays server-side",
  "type": "module",
  "scripts": {
    "start": "netlify dev",
    "test": "node --import tsx --test test/*.test.js",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "netlify-cli": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.46.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
