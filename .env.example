# Client (Vite) — set this to your Convex deployment URL from the dashboard
# (Settings → URL), e.g. https://happy-animal-123.convex.cloud
VITE_CONVEX_URL=

# Netlify / local serverless (OpenRouter stays on Netlify functions ONLY)
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Convex dashboard environment variables (NOT Vite — set via `npx convex env set`
# or Dashboard → Settings → Environment Variables):
#
#   AUTH_GOOGLE_ID=          # Google OAuth client ID
#   AUTH_GOOGLE_SECRET=      # Google OAuth client secret
#   SITE_URL=                # Your frontend origin, e.g. http://localhost:5173
#                            # or https://your-site.netlify.app
#   CONVEX_SITE_URL=         # Auto-set by Convex (*.convex.site) — used as the
#                            # OAuth callback host: {CONVEX_SITE_URL}/api/auth/callback/google
#   JWT_PRIVATE_KEY=         # Generated by `npx @convex-dev/auth` / key script
#   JWKS=                    # Generated alongside JWT_PRIVATE_KEY
#
# Do not put OPENROUTER_API_KEY in Convex or in any VITE_* variable.
# ---------------------------------------------------------------------------
