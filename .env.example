# Client (Vite) — Convex deployment URL (Settings → URL), e.g. https://happy-animal-123.convex.cloud
VITE_CONVEX_URL=

# Netlify / local serverless (OpenRouter stays on Netlify functions ONLY)
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Convex dashboard environment variables (NOT Vite — set via `npx convex env set`
# or Dashboard → Settings → Environment Variables):
#
#   SITE_URL=                # Frontend origin, e.g. https://cleverbot.netlify.app
#   JWT_PRIVATE_KEY=         # Generated by `npx @convex-dev/auth`
#   JWKS=                    # Generated alongside JWT_PRIVATE_KEY
#
# Auth methods: Password (email) + Anonymous. No OAuth client IDs required.
# Do not put OPENROUTER_API_KEY in Convex or in any VITE_* variable.
# ---------------------------------------------------------------------------
